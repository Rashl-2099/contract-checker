OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Security settings (optional)
# session = each visitor sees only their own history (default, use for public deployments)
# shared  = one shared history (only for a private single-user machine)
HISTORY_MODE=session
# AI usage limits: per session, and per hour for all visitors (0 = unlimited)
LLM_SESSION_LIMIT=5
NEGOTIATION_SESSION_LIMIT=10
LLM_HOURLY_LIMIT=60
